@model GrimService.Models.Admin.AdminPlayerViewModel
@{ ViewData["Title"] = T["Gracz"] + " " + Model.Player.PSNUserId; }
<div class="d-flex justify-content-between align-items-center mb-3"><div><a asp-action="Index">@T["← Panel"]</a><h1 class="h2 mb-0">@Model.Player.PSNUserId <small class="text-muted">#@Model.Player.Id</small></h1></div><span class="badge @(Model.IsConnected ? "bg-success" : "bg-secondary")">@(Model.IsConnected ? T["Online"] : T["Offline"])</span></div>
<div class="row g-3">
 <div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5">@T["Moderacja"]</h2>
 @if (Model.Player.BanStatus == "1") { <p class="text-danger">@T["Zbanowany."] @Model.BanReason</p><form method="post" asp-action="Unban" asp-route-id="@Model.Player.Id">@Html.AntiForgeryToken()<button class="btn btn-success w-100">@T["Odbanuj"]</button></form> } else { <form method="post" asp-action="Ban" asp-route-id="@Model.Player.Id">@Html.AntiForgeryToken()<label class="form-label">@T["Powód bana"]</label><textarea class="form-control mb-2" name="reason" maxlength="1000" required></textarea><button class="btn btn-danger w-100">@T["Zbanuj i wyloguj"]</button></form> }
 <form class="mt-2" method="post" asp-action="DropSession" asp-route-id="@Model.Player.Id">@Html.AntiForgeryToken()<button class="btn btn-warning w-100">@T["Wymuś wylogowanie"]</button></form>
 </div></div></div>
 <div class="col-lg-8"><div class="card"><div class="card-body"><h2 class="h5">@T["Dane gracza"]</h2><form method="post" asp-action="Edit" asp-route-id="@Model.Player.Id">@Html.AntiForgeryToken()
 <div class="row g-2"><div class="col-md-6"><label class="form-label">@T["Nick"]</label><input class="form-control" name="nickname" value="@Model.Player.Nickname" /></div><div class="col-md-6"><label class="form-label">@T["Kredyty"]</label><input class="form-control" name="credit" value="@Model.Player.Credit" /></div><div class="col-12"><label class="form-label">@T["Komentarz"]</label><textarea class="form-control" name="comment">@Model.Player.Comment</textarea></div><div class="col-12"><label class="form-label">@T["Welcome message"]</label><textarea class="form-control" name="welcomeMessage">@Model.Player.WelcomeMessage</textarea></div></div><button class="btn btn-primary mt-3">@T["Zapisz dane"]</button></form>
 <hr/><dl class="row mb-0"><dt class="col-sm-4">IP</dt><dd class="col-sm-8">@Model.Player.IPAddress</dd><dt class="col-sm-4">MAC</dt><dd class="col-sm-8">@Model.Player.MacAddress</dd><dt class="col-sm-4">@T["Gra / platforma"]</dt><dd class="col-sm-8">@Model.Player.LastGame / @Model.Player.Platform</dd><dt class="col-sm-4">@T["Logowania"]</dt><dd class="col-sm-8">@Model.Player.NumbersOfLogin</dd></dl>
 </div></div></div>
</div>
<div class="row g-3 mt-1">
 <div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5">@T["Trasy"] (@Model.Courses.Count)</h2><ul class="list-group list-group-flush">@foreach(var item in Model.Courses) { <li class="list-group-item">#@item.Id @item.Title <form class="d-inline float-end" method="post" asp-action="DeleteCourse" asp-route-playerId="@Model.Player.Id" asp-route-courseId="@item.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">@T["Usuń"]</button></form></li> }</ul></div></div></div>
 <div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5">@T["Zdjęcia"] (@Model.Photos.Count)</h2><ul class="list-group list-group-flush">@foreach(var item in Model.Photos) { <li class="list-group-item">#@item.Id @item.CarName <form class="d-inline float-end" method="post" asp-action="DeletePhoto" asp-route-playerId="@Model.Player.Id" asp-route-photoId="@item.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">@T["Usuń"]</button></form></li> }</ul></div></div></div>
 <div class="col-lg-4"><div class="card"><div class="card-body"><h2 class="h5">@T["Replaye"] (@Model.Replays.Count)</h2><ul class="list-group list-group-flush">@foreach(var item in Model.Replays) { <li class="list-group-item">#@item.Id @item.BoardId <form class="d-inline float-end" method="post" asp-action="DeleteReplay" asp-route-playerId="@Model.Player.Id" asp-route-replayId="@item.Id">@Html.AntiForgeryToken()<button class="btn btn-sm btn-outline-danger">@T["Usuń"]</button></form></li> }</ul></div></div></div>
</div>
