# Loaded only by the GrimService process via start-grimservice.sh.
# Native TLS 1.0 needs RSA/AES-CBC/SHA1 and OpenSSL security level 0.
# GT5 SSL 3.0 is handled separately by BouncyCastle, before native HTTPS.
# Modern TLS suites remain available.
openssl_conf = grim_init

[grim_init]
ssl_conf = grim_ssl

[grim_ssl]
system_default = grim_https

[grim_https]
MinProtocol = TLSv1
MaxProtocol = TLSv1.3
CipherString = ECDHE-ECDSA-AES256-GCM-SHA384:ECDHE-ECDSA-AES128-GCM-SHA256:ECDHE-RSA-AES256-GCM-SHA384:ECDHE-RSA-AES128-GCM-SHA256:ECDHE-ECDSA-AES256-SHA384:ECDHE-ECDSA-AES128-SHA256:ECDHE-RSA-AES256-SHA384:ECDHE-RSA-AES128-SHA256:AES128-SHA:AES256-SHA:@SECLEVEL=0
Ciphersuites = TLS_AES_256_GCM_SHA384:TLS_CHACHA20_POLY1305_SHA256:TLS_AES_128_GCM_SHA256
